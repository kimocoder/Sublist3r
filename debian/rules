#!/usr/bin/make -f

# output every command that modifies files on the build system.
#export DH_VERBOSE = 1

export PYBUILD_NAME=sublist3r

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_install:
	dh_install
	rm debian/sublist3r/usr/lib/python3*/dist-packages/MANIFEST.in
	rm debian/sublist3r/usr/lib/python3*/dist-packages/README.md
	rm debian/sublist3r/usr/lib/python3*/dist-packages/LICENSE
